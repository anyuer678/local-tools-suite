# Python 运行时与打包缓存
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 测试与覆盖率产物
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# PyInstaller 构建产物与自动生成的 spec
build/
dist/
*.spec

# 发布二进制（ZIP / 安装器体积大，不入库；校验清单 SHA256SUMS.txt 保留）
release/*.zip
release/installers/

# 走查截图与本地临时数据
.screenshots/
*.log
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
